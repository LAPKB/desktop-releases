{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/LAPKB/desktop-releases/main/schemas/publisher-trust-v1.schema.json",
  "title": "Protected local publisher trust configuration v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "root", "origin", "pickupRepository", "checkmateMinimumVersion", "legacyAliases", "apps"],
  "properties": {
    "schema": {"const": "lapkb-publisher-trust-v1"},
    "root": {"type": "string", "pattern": "^/(?!/)(?:[^/]+/)*[^/]+$"},
    "origin": {"type": "string", "pattern": "^https://(?:[a-z0-9.-]+|\\[[a-f0-9:]+\\])(?::[0-9]{1,5})?$"},
    "pickupRepository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "checkmateMinimumVersion": {"$ref": "build-attestation-v1.schema.json#/$defs/version"},
    "legacyAliases": {
      "type": "object", "additionalProperties": false, "required": ["launcher", "papir", "bestdose", "bdautodial", "checkerboard"],
      "properties": {
        "launcher": {"$ref": "#/$defs/aliases"}, "papir": {"$ref": "#/$defs/aliases"}, "bestdose": {"$ref": "#/$defs/aliases"},
        "bdautodial": {"$ref": "#/$defs/aliases"}, "checkerboard": {"$ref": "#/$defs/aliases"}
      }
    },
    "apps": {
      "type": "object", "additionalProperties": false, "required": ["launcher", "papir", "bestdose", "bdautodial", "checkerboard"],
      "properties": {
        "launcher": {"$ref": "#/$defs/app-launcher"}, "papir": {"$ref": "#/$defs/app-papir"}, "bestdose": {"$ref": "#/$defs/app-bestdose"},
        "bdautodial": {"$ref": "#/$defs/app-bdautodial"}, "checkerboard": {"$ref": "#/$defs/app-checkerboard"}
      }
    }
  },
  "$defs": {
    "aliases": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "stable": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}]},
        "beta": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}]}
      }
    },
    "signed-channel": {
      "type": "object", "additionalProperties": false, "required": ["publicKey", "keyId", "profiles"],
      "properties": {
        "publicKey": {"type": "string", "minLength": 1, "maxLength": 4096},
        "keyId": {"$ref": "build-attestation-v1.schema.json#/$defs/key-id"},
        "profiles": {"$ref": "#/$defs/targetProfiles"}, "manualTargets": {"const": []}
      }
    },
    "manual-channel": {
      "type": "object", "additionalProperties": false, "required": ["publicKey", "keyId", "profiles", "manualTargets"],
      "properties": {
        "publicKey": {"type": "null"}, "keyId": {"type": "null"}, "manualTargets": {"const": ["windows-x86_64"]},
        "profiles": {
          "type": "object", "additionalProperties": false, "required": ["windows-x86_64"],
          "properties": {"windows-x86_64": {"$ref": "#/$defs/manual-nsis-profiles"}}
        }
      }
    },
    "channelPolicies": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"stable": {"oneOf": [{"$ref": "#/$defs/signed-channel"}, {"$ref": "#/$defs/manual-channel"}]}, "beta": {"$ref": "#/$defs/signed-channel"}}
    },
    "signed-channels": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {"stable": {"$ref": "#/$defs/signed-channel"}, "beta": {"$ref": "#/$defs/signed-channel"}}
    },
    "appBase": {
      "type": "object", "additionalProperties": false, "required": ["sourceRepository", "branch", "bundleIdentifier", "executable", "channels"],
      "properties": {
        "sourceRepository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "branch": {"type": "string", "minLength": 1, "maxLength": 128},
        "bundleIdentifier": {"type": "string", "minLength": 1, "maxLength": 128},
        "executable": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "allowedCoverages": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["full-six", "windows-x64", "launcher-desktop"]}},
        "retainedManualRecords": {"type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 2,
          "properties": {"0.1.9": {"$ref": "build-attestation-v1.schema.json#/$defs/hash"}, "0.1.10": {"$ref": "build-attestation-v1.schema.json#/$defs/hash"}}},
        "channels": {"$ref": "#/$defs/channelPolicies"}
      },
      "allOf": [{
        "if": {"required": ["allowedCoverages"], "properties": {"allowedCoverages": {"const": ["windows-x64"]}}},
        "then": {"properties": {"channels": {"$ref": "#/$defs/windows-channels"}}},
        "else": {
          "if": {"required": ["allowedCoverages"], "properties": {"allowedCoverages": {"type": "array", "contains": {"const": "launcher-desktop"}}}},
          "then": {"properties": {"channels": {"$ref": "#/$defs/launcher-desktop-channels"}}},
          "else": {"properties": {"channels": {"$ref": "#/$defs/full-six-channels"}}}
        }
      }, {
        "if": {"required": ["allowedCoverages"], "properties": {"allowedCoverages": {"type": "array", "contains": {"const": "windows-x64"}}}},
        "then": {"properties": {"channels": {"type": "object", "properties": {
          "stable": {"$ref": "#/$defs/windows-nsis-channel"}, "beta": {"$ref": "#/$defs/windows-nsis-channel"}
        }}}}
      }]
    },
    "app-launcher": {
      "allOf": [{"$ref": "#/$defs/appBase"}, {
        "type": "object", "properties": {"bundleIdentifier": {"const": "org.lapkb.launcher"}, "channels": {"$ref": "#/$defs/channelPolicies"}},
        "allOf": [{
          "if": {"required": ["retainedManualRecords"]},
          "then": {"required": ["allowedCoverages"], "properties": {"allowedCoverages": {"const": ["launcher-desktop"]}, "channels": {"$ref": "#/$defs/signed-channels"}}}
        }, {
          "if": {"required": ["allowedCoverages"], "properties": {"allowedCoverages": {"type": "array", "contains": {"const": "launcher-desktop"}}}},
          "then": {"properties": {"allowedCoverages": {"const": ["launcher-desktop"]}}}
        }]
      }]
    },
    "app-papir": {"allOf": [{"$ref": "#/$defs/appBase"}, {"type": "object", "properties": {"bundleIdentifier": {"const": "com.papir.app"}, "channels": {"$ref": "#/$defs/signed-channels"}, "retainedManualRecords": false, "allowedCoverages": {"type": "array", "items": {"enum": ["full-six", "windows-x64"]}}}}]},
    "app-bestdose": {"allOf": [{"$ref": "#/$defs/appBase"}, {"type": "object", "properties": {"bundleIdentifier": {"const": "org.lapkb.bestdose"}, "channels": {"$ref": "#/$defs/signed-channels"}, "retainedManualRecords": false, "allowedCoverages": {"type": "array", "items": {"enum": ["full-six", "windows-x64"]}}}}]},
    "app-bdautodial": {"allOf": [{"$ref": "#/$defs/appBase"}, {"type": "object", "properties": {"bundleIdentifier": {"const": "com.bdautodial.desktop"}, "channels": {"$ref": "#/$defs/signed-channels"}, "retainedManualRecords": false, "allowedCoverages": {"type": "array", "items": {"enum": ["full-six", "windows-x64"]}}}}]},
    "app-checkerboard": {"allOf": [{"$ref": "#/$defs/appBase"}, {"type": "object", "properties": {"bundleIdentifier": {"const": "org.lapkb.checkmate"}, "executable": {"const": "checkmate-desktop"}, "channels": {"$ref": "#/$defs/signed-channels"}, "retainedManualRecords": false, "allowedCoverages": {"type": "array", "items": {"enum": ["full-six", "windows-x64"]}}}}]},
    "launcher-desktop-channels": {
      "type": "object", "additionalProperties": false, "required": ["stable"],
      "properties": {"stable": {"allOf": [{"$ref": "#/$defs/signed-channel"}, {"properties": {"profiles": {
        "type": "object", "additionalProperties": false, "required": ["darwin-aarch64", "windows-x86_64"],
        "properties": {"darwin-aarch64": {"allOf": [{"$ref": "#/$defs/profileList"}, {
          "type": "array", "maxItems": 3,
          "contains": {"type": "object", "properties": {"roles": {"type": "array", "contains": {"const": "updater"}}}}, "minContains": 1, "maxContains": 1,
          "items": {"type": "object", "if": {"properties": {"roles": {"type": "array", "contains": {"const": "updater"}}}},
            "then": {"properties": {"extension": {"const": "app.tar.gz"}, "kind": {"const": "app-tar-gz"}, "required": {"const": true}}}}
        }]}, "windows-x86_64": {"$ref": "#/$defs/signed-nsis-profiles"}}
      }}}]}}
    },
    "windows-channels": {
      "type": "object", "properties": {"stable": {"$ref": "#/$defs/windows-profiles-channel"}, "beta": {"$ref": "#/$defs/windows-profiles-channel"}}
    },
    "windows-profiles-channel": {
      "type": "object", "properties": {"profiles": {
        "type": "object", "additionalProperties": false, "required": ["windows-x86_64"], "properties": {"windows-x86_64": {"$ref": "#/$defs/profileList"}}
      }}
    },
    "windows-nsis-channel": {
      "type": "object", "properties": {"manualTargets": {"type": "array"}},
      "if": {"required": ["manualTargets"], "properties": {"manualTargets": {"const": ["windows-x86_64"]}}},
      "then": {"properties": {"profiles": {"type": "object", "properties": {"windows-x86_64": {"$ref": "#/$defs/manual-nsis-profiles"}}}}},
      "else": {"properties": {"profiles": {"type": "object", "properties": {"windows-x86_64": {"$ref": "#/$defs/signed-nsis-profiles"}}}}}
    },
    "signed-nsis-profiles": {
      "type": "array", "minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/profile"}, {"type": "object", "properties": {
        "extension": {"const": "exe"}, "kind": {"const": "nsis"}, "roles": {"const": ["installer", "updater"]}, "required": {"const": true}
      }}]}
    },
    "manual-nsis-profiles": {
      "type": "array", "minItems": 1, "maxItems": 1, "items": {"allOf": [{"$ref": "#/$defs/profile"}, {"type": "object", "properties": {
        "extension": {"const": "exe"}, "kind": {"const": "nsis"}, "roles": {"const": ["installer"]}, "required": {"const": true}
      }}]}
    },
    "full-six-channels": {
      "type": "object", "properties": {"stable": {"$ref": "#/$defs/full-six-profiles-channel"}, "beta": {"$ref": "#/$defs/full-six-profiles-channel"}}
    },
    "full-six-profiles-channel": {
      "type": "object", "properties": {"profiles": {
        "type": "object", "required": ["darwin-aarch64", "darwin-x86_64", "windows-aarch64", "windows-x86_64", "linux-aarch64", "linux-x86_64"],
        "properties": {
          "darwin-aarch64": {"$ref": "#/$defs/profileList"}, "darwin-x86_64": {"$ref": "#/$defs/profileList"},
          "windows-aarch64": {"$ref": "#/$defs/profileList"}, "windows-x86_64": {"$ref": "#/$defs/profileList"},
          "linux-aarch64": {"$ref": "#/$defs/profileList"}, "linux-x86_64": {"$ref": "#/$defs/profileList"}
        }
      }}
    },
    "targetProfiles": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "darwin-aarch64": {"$ref": "#/$defs/profileList"}, "darwin-x86_64": {"$ref": "#/$defs/profileList"},
        "windows-aarch64": {"$ref": "#/$defs/profileList"}, "windows-x86_64": {"$ref": "#/$defs/profileList"},
        "linux-aarch64": {"$ref": "#/$defs/profileList"}, "linux-x86_64": {"$ref": "#/$defs/profileList"}
      }
    },
    "profileList": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/profile"}},
    "profile": {
      "type": "object", "additionalProperties": false, "required": ["id", "extension", "kind", "roles", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}, "extension": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,63}$"},
        "kind": {"type": "string", "minLength": 1, "maxLength": 64},
        "roles": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["installer", "updater"]}}, "required": {"type": "boolean"}
      }
    }
  }
}
